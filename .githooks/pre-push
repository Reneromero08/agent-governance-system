#!/bin/sh
# Pre-push hook: require a verification receipt for the commit actually pushed.
set -e

# A foreign-platform virtualenv can still have executable permission. Probe the
# interpreter instead of trusting its mode bit so Linux does not select a
# checked-in Windows python.exe (and Windows can still select its own venv).
PYTHON_CMD=""
for CANDIDATE in .venv/bin/python .venv/Scripts/python.exe python3 python; do
    if "$CANDIDATE" --version >/dev/null 2>&1; then
        PYTHON_CMD="$CANDIDATE"
        break
    fi
done
if [ -z "$PYTHON_CMD" ]; then
    echo "[PRE-PUSH] ERROR: No Python found"
    exit 1
fi

ZERO_SHA="0000000000000000000000000000000000000000"
TOKEN_FILE="LAW/CONTRACTS/_runs/ALLOW_PUSH.token"
GUARD="CAPABILITY/TOOLS/utilities/pre_push_guard.py"
SCOPE_TOOL="CAPABILITY/TOOLS/utilities/lab_scope.py"
LAB_ACCEPTANCE="CAPABILITY/TOOLS/utilities/lab_isolation_acceptance.py"
REMOTE_NAME="$1"
REF_UPDATES=$(cat)

while read local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" != "$ZERO_SHA" ] && echo "$remote_ref" | grep -qE '^refs/tags/v[0-9]'; then
        TAG_NAME=$(echo "$remote_ref" | sed 's|refs/tags/||')
        SEAL_DIR="NAVIGATION/PROOFS/RELEASES/$TAG_NAME"
        echo "[PRE-PUSH] Release tag detected: $TAG_NAME"
        if [ ! -f "$SEAL_DIR/RELEASE_MANIFEST.json" ]; then
            echo "[PRE-PUSH] ERROR: release tag has no seal at $SEAL_DIR"
            exit 1
        fi
        if ! "$PYTHON_CMD" -m CAPABILITY.TOOLS.catalytic.verify_release --repo-dir . --version "$TAG_NAME"; then
            echo "[PRE-PUSH] ERROR: release seal verification failed"
            exit 1
        fi
    fi
done <<EOF
$REF_UPDATES
EOF

# No-op pushes and deletion-only pushes introduce no new commit content.
if [ -z "$REF_UPDATES" ]; then
    echo "[PRE-PUSH] No ref updates; verification receipt not required."
    exit 0
fi
if printf '%s\n' "$REF_UPDATES" | awk -v zero="$ZERO_SHA" 'NF && $2 != zero { found=1 } END { exit found ? 1 : 0 }'; then
    echo "[PRE-PUSH] Deletion-only push; verification receipt not required."
    exit 0
fi

SCOPE=$(printf '%s\n' "$REF_UPDATES" | "$PYTHON_CMD" "$SCOPE_TOOL" check-push --remote-name "$REMOTE_NAME") || exit $?
if [ "$SCOPE" = "EMPTY" ]; then
    echo "[PRE-PUSH] No commits are introduced."
    exit 0
fi

if [ "$SCOPE" = "LAB_PAYLOAD" ]; then
    echo "[PRE-PUSH] Route: Lab payload (linear history, no main receipt)."
    "$PYTHON_CMD" "$SCOPE_TOOL" audit --lab-session >/dev/null
    if ! git diff --cached --quiet; then
        echo "PUSH BLOCKED: staged changes are not committed"
        exit 1
    fi
    echo "[PRE-PUSH] Lab push approved."
    exit 0
fi

if [ "$SCOPE" = "LAB_BOUNDARY_CONTROL" ]; then
    echo "[PRE-PUSH] Route: Lab boundary maintenance; running isolation acceptance."
    "$PYTHON_CMD" "$LAB_ACCEPTANCE"
else
    echo "[PRE-PUSH] Route: main governance."
fi

if [ ! -f "$TOKEN_FILE" ]; then
    echo ""
    echo "PUSH BLOCKED: no verification receipt"
    echo "Run: python CAPABILITY/TOOLS/utilities/ci_local_gate.py --full"
    echo "For release/nightly depth: add --exhaustive"
    exit 1
fi

set +e
printf '%s\n' "$REF_UPDATES" | "$PYTHON_CMD" "$GUARD" --token-file "$TOKEN_FILE"
GUARD_RC=$?
set -e

if [ "$GUARD_RC" -eq 2 ]; then
    echo "[PRE-PUSH] Legacy/manual token detected; running the canonical full gate."
    "$PYTHON_CMD" CAPABILITY/TOOLS/utilities/ci_local_gate.py --full
    printf '%s\n' "$REF_UPDATES" | "$PYTHON_CMD" "$GUARD" --token-file "$TOKEN_FILE"
elif [ "$GUARD_RC" -ne 0 ]; then
    echo "Re-run: python CAPABILITY/TOOLS/utilities/ci_local_gate.py --full"
    exit "$GUARD_RC"
fi

if ! git diff --cached --quiet; then
    echo "PUSH BLOCKED: staged changes are not committed"
    exit 1
fi

echo "[PRE-PUSH] Push approved."
echo "[PRE-PUSH] Receipt retained. A new commit invalidates it automatically."
exit 0
